# Copy this file to .env and fill in your real values. Never commit .env.

# Required: Groq API key for the LLM calls made by the agents.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: raises GitHub API rate limits from 60/hr to 5000/hr.
GITHUB_TOKEN=

# Optional: enables the web_search tool used by the Content Improver agent.
# Without it, the pipeline still runs, just without web positioning context.
TAVILY_API_KEY=

# Optional model overrides. See https://console.groq.com/docs/models for options.
MODEL_NAME=llama-3.3-70b-versatile
MODEL_TEMPERATURE=0.3
